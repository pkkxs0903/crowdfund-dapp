# Sepolia RPC endpoint (Alchemy / Infura / public gateway)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<your-key>
# Never commit a real key. Use a throw-away testnet account only.
PRIVATE_KEY=0x<64-hex-chars>
# Etherscan API key for contract verification
ETHERSCAN_API_KEY=<your-etherscan-key>
# Optional: address that receives the 2% platform fee (defaults to deployer)
PLATFORM_FEE_RECIPIENT=
